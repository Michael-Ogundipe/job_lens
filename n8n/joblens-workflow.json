      "id": "13",
      "name": "Manual Job Inbox (LinkedIn, etc.)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        340
      ],
      "webhookId": "joblens-manual-job"
    },
    {
      "parameters": {
        "jsCode": "const body = $json.body || $json || {};\nconst title = (body.title || '').toString().trim();\nconst company = (body.company || '').toString().trim();\nconst application_url = body.application_url || body.url || null;\nconst now = new Date().toISOString();\nconst slug = `${company}-${title}`.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');\nconst job = {\n  external_id: body.external_id || slug || `manual-${Date.now()}`,\n  source: body.source || 'manual',\n  source_url: body.source_url || application_url,\n  application_url: application_url,\n  company: company,\n  company_url: body.company_url || null,\n  title: title,\n  description: body.description || '',\n  location: body.location || null,\n  remote: !!body.remote,\n  employment_type: body.employment_type || null,\n  posted_at: body.posted_at || now,\n};\nreturn [{ json: job }];"
      },
      "id": "14",
      "name": "Prepare Manual Job",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        340
      ]
    },
    {
      "parameters": {
        "url": "http://api:8000/api/discover/jobs?max_age_days=3&remote_only=false&exclude_seen=true",
        "options": {}
      },
      "id": "2",
      "name": "Discover Real Jobs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const items = $input.all();\nconst jobs = items.map(i => i.json);\nconst seen = new Set();\nconst output = [];\nfor (const job of jobs) {\n  const key = (job.application_url || `${job.company}|${job.title}`).toLowerCase().trim();\n  if (seen.has(key)) continue;\n  seen.add(key);\n  output.push({ json: job });\n}\nconsole.log(`[JobLens Debug] Deduplicate Jobs: ${items.length} in -> ${output.length} out`);\nreturn output;"
      },
      "id": "3",
      "name": "Deduplicate Jobs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
