      ]
    },
    {
      "id": "6",
      "name": "Active Only",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Keep a job if it has the required fields + an application URL.\n// Validation result is attached for confidence/reference only - it does NOT gate inclusion.\nconst REQUIRED_FIELDS = ['title', 'company', 'location', 'source', 'posted_at'];\nconst items = $input.all();\nconst output = [];\nlet dropped = 0;\n\nfor (const item of items) {\n  const job = item.json;\n  const hasRequired = REQUIRED_FIELDS.every(\n    f => job[f] !== undefined && job[f] !== null && String(job[f]).trim() !== ''\n  );\n  const hasRemoteField = job.remote !== undefined && job.remote !== null; // false is a valid value\n  const hasApplicationUrl = !!job.application_url;\n\n  if (hasRequired && hasRemoteField && hasApplicationUrl) {\n    output.push(item);\n  } else {\n    dropped++;\n  }\n}\n\nconsole.log(`[JobLens Debug] Active Only: ${items.length} in -> ${output.length} out (dropped ${dropped} missing required fields/application URL; validation status NOT used to filter)`);\nreturn output;"
      }
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nreturn items.map(({ json }) => {\n  const job = json.job || json;\n\n  return { json: {\n    'Job Title': job.title || json.title || '',\n    'Company': job.company || json.company || '',\n    'Location': job.location || json.location || '',\n    'Remote': (job.remote ?? json.remote) ? 'Yes' : 'No',\n    'Source': job.source || json.source || '',\n    'Posted': job.posted_at || json.posted_at || '',\n    'Application': job.application_url || json.application_url || '',\n  }};\n});\n"
      },
